{
  "id": "ffmpeg_image_composite",
  "name": "FFmpeg 图片合成",
  "description": "两张图片并排、叠加、对比拼接，生成对比视频",
  "category": "composite",
  "match_rules": {
    "asset_type": [
      "image",
      "local"
    ],
    "keywords": [
      "对比",
      "并排",
      "左右",
      "比较",
      "分屏"
    ]
  },
  "usage": {
    "required_params": [
      "image_left",
      "image_right",
      "duration"
    ],
    "optional_params": [
      "layout",
      "gap",
      "background_color"
    ],
    "note": "layout: 'side_by_side' / 'stack_vertical'; gap: 间距像素"
  },
  "workflow_type": "ffmpeg",
  "command_template": "ffmpeg -y -loop 1 -i {img_left} -loop 1 -i {img_right} -filter_complex {filter} -t {duration} -pix_fmt {{ffmpeg.pix_fmt}} -c:v libx264 -crf {{ffmpeg.crf}} {output}",
  "injectable_params": [
    "image_left",
    "image_right",
    "duration",
    "output",
    "layout"
  ]
}